# Copy this file to .env and fill in your values. Never commit .env!
DISCORD_TOKEN=put-your-bot-token-here
# Optional: your server ID. Commands then appear instantly in that server (good for testing).
# Leave empty to register commands globally (can take up to an hour the first time).
GUILD_ID=
# Set to 0 to turn off fetching pictures from anvilempires.wiki.gg
WIKI_IMAGES=1
